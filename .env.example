# KI (KI-Tutor / Erklärungen). Serverseitig via Vite-Proxy (dev) bzw. api/ai/chat.ts (Vercel).
OPENROUTER_API_KEY=sk-or-...

# Firebase (optional). Ohne diese Werte läuft die App rein lokal ohne Login/Cloud.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=xxx.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=xxx
VITE_FIREBASE_STORAGE_BUCKET=xxx.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Kommaseparierte Liste der Admin-E-Mails (dürfen Folien hochladen).
VITE_ADMIN_EMAILS=deine@mail.ch
